pipeline {
    agent any

    environment {
        COMMITDATE = ""
        TARGET_SERVER = "ubuntu@3.230.217.30"
        DEPLOY_PATH = "/var/www/html/Quiz/quiz_react/"
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    notifyBuild('STARTED')
                    COMMITDATE = sh(returnStdout: true, script: "git show -s --format=%ci ${GIT_COMMIT}").trim()
                    echo "Commit Date: ${COMMITDATE}"
                    sh "git rev-parse --abbrev-ref HEAD"
                    echo "Branch: ${env.GIT_BRANCH}"
                }
            }
        }

        stage('Stage-Build') {
            when { expression { env.GIT_BRANCH == 'origin/develop' } }
            steps {
                dir('quiz_react') {
                    sh '''
                      set -e
                      curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.5/install.sh | bash
                      export NVM_DIR="$HOME/.nvm"
                      [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                      nvm install 20.19.4
                      nvm use 20.19.4

                      echo "Installing dependencies..."
                      if [ -f package-lock.json ]; then
                        npm ci
                      else
                        npm install
                      fi

                      echo "Building React app..."
                      npm run build
                    '''
                }
            }
        }

        stage('Stage-Deploy') {
            when { expression { env.GIT_BRANCH == 'origin/develop' } }
            steps {
                dir('quiz_react') {
                    sshagent(['JENKINS_CREDENTIAL_ID']) {   // 👈 use Jenkins SSH key
                        sh '''
                          set -e
                          echo ">>> Checking SSH connectivity to target server..."
                          ssh -o StrictHostKeyChecking=no ${TARGET_SERVER} 'echo SSH OK'

                          echo ">>> Deploying dist/ folder to remote server..."
                          rsync -avz --delete ./dist/ ${TARGET_SERVER}:${DEPLOY_PATH}

                          echo ">>> Setting permissions on remote server..."
                          ssh -o StrictHostKeyChecking=no ${TARGET_SERVER} \
                            "sudo chown -R www-data:www-data ${DEPLOY_PATH} && \
                             sudo chmod -R 755 ${DEPLOY_PATH}"
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (fileExists('quiz_react/dist')) {
                    archiveArtifacts artifacts: 'quiz_react/dist/**/*', fingerprint: true
                    echo "Dist folder archived as build artifact"
                }
            }
        }
        cleanup {
            echo "Pipeline completed - workspace preserved for debugging"
        }
    }
}

def notifyBuild(String buildStatus = 'STARTED') {
    buildStatus = buildStatus ?: 'SUCCESSFUL'
    def colorCode = '#FF0000'
    def summary = "${buildStatus}: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})"

    if (buildStatus == 'STARTED') {
        colorCode = '#FFFF00'
    } else if (buildStatus == 'SUCCESS') {
        colorCode = '#00FF00'
    }

    echo "Slack notify: ${summary}"
    // slackSend(color: colorCode, message: summary)
}
